    <!-- Demo -->
    <string name="datasources_demo_title">Live sources are paused</string>
    <string name="datasources_demo_body">Demo mode shows made-up data from a separate store. Google Health, Health Connect and Takeout are not read, and demo data never touches your real data. Leave Demo mode in Settings to use live sources.</string>

    <!-- Google Health card -->
    <string name="datasources_google_section">Google Health</string>
    <string name="datasources_google_status_label">Connection</string>
    <string name="datasources_google_connected">Connected</string>
    <string name="datasources_google_signed_out">Not connected</string>
    <string name="datasources_google_needs_reauth">Sign in again</string>
    <string name="datasources_google_not_configured">Not set up</string>
    <string name="datasources_google_loading">Checking</string>
    <string name="datasources_google_not_configured_body">Apex has no Google client ID yet, so it cannot sign in. Add one in Settings or in local.properties and rebuild. The steps are in docs/SETUP.md.</string>
    <string name="datasources_google_signed_out_body">Connect to read the data your Fitbit Air uploaded to Google Health. Apex asks for read-only access and never writes.</string>
    <string name="datasources_google_connected_body">Apex reads your wearable data from Google Health with read-only access.</string>
    <string name="datasources_google_reauth_refresh_rejected">Google ended this sign-in. If your Google Cloud consent screen is still in Testing, Google expires sign-ins after 7 days. Sign in again, or set the consent screen to In production. Your data on this phone is untouched.</string>
    <string name="datasources_google_reauth_access_rejected">Google no longer accepts this sign-in. Please sign in again. Your data on this phone is untouched.</string>
    <string name="datasources_google_reauth_no_refresh">Google did not give Apex a way to renew the sign-in. Sign in again and accept the consent screen. Your data on this phone is untouched.</string>
    <string name="datasources_google_reauth_client_changed">The Google client ID changed, so the old sign-in cannot be used. Please sign in again.</string>
    <string name="datasources_google_reauth_client_rejected">Google rejected this app\'s client. Check the client ID and that your account is listed as a test user, then sign in again.</string>
