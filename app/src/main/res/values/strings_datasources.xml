    <string name="datasources_google_disconnect">Disconnect</string>
    <string name="datasources_google_disconnect_title">Disconnect Google Health?</string>
    <string name="datasources_google_disconnect_body">Apex will stop reading from Google Health and ask Google to end the grant. Data already on this phone stays.</string>
    <string name="datasources_google_disconnect_confirm">Disconnect</string>
    <string name="datasources_google_disconnect_cancel">Keep connected</string>

