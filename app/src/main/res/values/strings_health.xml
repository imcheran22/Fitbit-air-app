    <string name="health_hr_info_title">How heart rate is shown</string>
    <string name="health_hr_info_buckets">Apex draws the day from 5-minute averages, so the lowest and highest values here are averages, not single beats. Gaps stay gaps.</string>
    <string name="health_hr_info_zones">Zone limits are 50, 60, 70, 80 and 90 percent of your maximum heart rate or heart rate reserve, as set in your profile.</string>
    <string name="health_hr_info_resting">Resting heart rate comes from your overnight data and is compared with your own 30-day average.</string>
