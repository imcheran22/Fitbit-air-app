    <!-- Effects -->
    <string name="journal_effects_title">Effects</string>
    <string name="journal_effects_intro">Differences in the next morning\'s recovery and heart rate variability over the last 90 days, comparing days you logged a factor as yes with days you logged it as no.</string>
    <string name="journal_effects_assoc_note">Associated with does not mean caused by. Sleep, training, meals and much else change on the same days. This is not medical advice.</string>
    <string name="journal_effects_none_logged">Log factors for a few days to see associations. Each factor needs at least %1$d days with it and %1$d days without it, each followed by a measured recovery or heart rate variability.</string>
    <string name="journal_effects_none_qualify">Nothing qualifies yet. Each factor needs at least %1$d days with it and %1$d days without it.</string>
    <string name="journal_effects_no_outcomes">There is no next-morning recovery or heart rate variability to compare with yet.</string>
    <string name="journal_effects_tests">Tests performed: %1$d. No correction is applied for running several, so some intervals will exclude zero by chance alone.</string>
    <string name="journal_effects_tests_zero">Tests performed: 0. No factor has enough days yet.</string>
