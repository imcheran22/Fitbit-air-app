<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        allowBackup is off on purpose: the database key is bound to this device's hardware
        keystore, and health data should not leave the phone in cloud backups.
    -->
    <application
        android:allowBackup="false"
        android:label="Apex"
        android:supportsRtl="true" />

</manifest>
